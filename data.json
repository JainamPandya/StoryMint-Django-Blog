itle": "Title: The Art of Slow Travel", "slug": "title-the-art-of-slow-travel", "category": 3, "author": ["djangoadmin"], "featured_image": "uploads/2026/09/30/Screenshot_1.png", "short_description": "Slow travel is about experiencing a destination instead of simply checking places off a list. Here is why taking your time can make a trip", "blog_body": "Travel does not always have to be about visiting as many places as possible. Sometimes, the best trips happen when we slow down and give ourselves time to experience a destination properly.", "status": "Draft", "is_featured": false, "created_at": "2026-09-30T10:14:51.584Z", "updated_at": "2026-09-30T10:14:51.584Z"}}, {"model": "blogs.blog", "pk": 4, "fields": {"title": "Why Learning to Code Is Easier Than You Think", "slug": "why-learning-to-code-is-easier-than-you-think", "category": 4, "author": ["djangoadmin"], "featured_image": "uploads/2026/09/30/Screenshot_3.png", "short_description": "Programming can look intimidating when you are just starting. A simple approach can make learning your first programming language much easier.", "blog_body": "Learning to code can seem difficult at first. New programmers often see complicated applications and wonder how anyone could build something like that.", "status": "Published", "is_featured": false, "created_at": "2026-09-30T10:15:46.423Z", "updated_at": "2026-09-30T13:18:18.229Z"}}, {"model": "blogs.blog", "pk": 5, "fields": {"title": "Building Better Habits One Small Step at a Time", "slug": "building-better-habits-one-small-step-at-a-time", "category": 5, "author": ["djangoadmin"], "featured_image": "uploads/2026/09/30/Screenshot_21.png", "short_description": "Big changes often begin with small, consistent actions. Learn how simple habits can gradually improve your everyday life.", "blog_body": "Many people start a new goal with enormous motivation. They create a strict schedule, make a long list of tasks, and expect themselves to follow everything perfectly.", "status": "Draft", "is_featured": false, "created_at": "2026-09-30T10:16:29.464Z", "updated_at": "2026-09-30T13:19:14.482Z"}}, {"model": "blogs.blog", "pk": 6, "fields": {"title": "A Beginner's Guide to Understanding Artificial Intelligence", "slug": "a-beginners-guide-to-understanding-artificial-intelligence", "category": 6, "author": ["djangoadmin"], "featured_image": "uploads/2026/09/30/Screenshot_4.png", "short_description": "Artificial intelligence has become part of everyday technology. This beginner-friendly guide explains the basic idea behind AI and machine learning.", "blog_body": "Artificial intelligence, commonly called AI, refers to computer systems designed to perform tasks that normally require some form of human intelligence.", "status": "Published", "is_featured": true, "created_at": "2026-09-30T10:17:25.952Z", "updated_at": "2026-09-30T13:18:51.841Z"}}, {"model": "blogs.blog", "pk": 7, "fields": {"title": "How to Plan a Weekend Trip Without Stress", "slug": "how-to-plan-a-weekend-trip-without-stress", "category": 3, "author": ["djangoadmin"], "featured_image": "uploads/2026/09/30/Screenshot_78.png", "short_description": "A short trip can be relaxing when you plan the important details without filling every minute of your schedule.", "blog_body": "Weekend trips are a great way to take a break without requiring a long vacation. However, trying to fit too many activities into two days can make the trip exhausting.", "status": "Published", "is_featured": true, "created_at": "2026-09-30T10:18:08.199Z", "updated_at": "2026-09-30T13:29:10.503Z"}}, {"model": "blogs.blog", "pk": 8, "fields": {"title": "Five Simple Ways to Improve Your Productivity", "slug": "five-simple-ways-to-improve-your-productivity", "category": 7, "author": ["djangoadmin"], "featured_image": "uploads/2026/09/30/Screenshot_93.png", "short_description": "Productivity is not about working every minute of the day. These simple techniques can help you focus on important tasks and reduce distractions.", "blog_body": "Being productive does not mean being busy all the time. True productivity is about spending your time and energy on things that actually matter.", "status": "Published", "is_featured": false, "created_at": "2026-09-30T10:18:39.773Z", "updated_at": "2026-09-30T12:18:47.370Z"}}, {"model": "admin.logentry", "pk": 1, "fields": {"action_time": "2026-09-29T05:01:12.215Z", "user": ["djangoadmin"], "content_type": ["blogs", "category"], "object_id": "1", "object_repr": "Category object (1)", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 2, "fields": {"action_time": "2026-09-30T04:57:39.559Z", "user": ["djangoadmin"], "content_type": ["blogs", "blog"], "object_id": "1", "object_repr": "Test Blog", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 3, "fields": {"action_time": "2026-09-30T05:11:34.890Z", "user": ["djangoadmin"], "content_type": ["blogs", "category"], "object_id": "2", "object_repr": "movie", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 4, "fields": {"action_time": "2026-09-30T05:12:09.541Z", "user": ["djangoadmin"], "content_type": ["blogs", "blog"], "object_id": "2", "object_repr": "new movie in the town", "action_flag": 1, "change_message": "[{\"added\": {}}]"}}, {"model": "admin.logentry", "pk": 5, "fields": {"action_time": "2026-09-30T09:49:14.998Z", "user": ["djangoadmin"], "content_type": ["blogs", "blog"], "object_id": "2", "object_repr": "new movie in the town", "action_flag": 2, "change_message": "[{\"changed\": {\"fields\": [\"Status\"]}}]"}}, {"model": "admin.logentry", "pk": 6, "fields": {"action_time": "2026-09-30T09:54:00.366Z", "user": ["djangoadmin"], "content_type": ["blogs", "blog"], "object_id": "2", "object_repr": "new movie in the town", "action_flag": 2, "change_message": "[{\"changed\": {\"fields\": [\"Status\"]}}]"}}, {"model": "admin.logentry", "pk": 7, "fields": {"action_time": "2